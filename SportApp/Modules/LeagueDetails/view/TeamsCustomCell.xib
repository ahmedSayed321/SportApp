<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24412" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24405"/>
        <capability name="collection view cell content view" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" reuseIdentifier="teamsCell" id="ZM0-qE-HlK" customClass="TeamsCollectionViewCell" customModule="SportApp" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="200" height="220"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <collectionViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" insetsLayoutMarginsFromSafeArea="NO" id="K03-LL-kra">
                <rect key="frame" x="0.0" y="0.0" width="200" height="220"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <!-- ✅ صورة الفريق بس بدون overlay -->
                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="img-view-id">
                        <rect key="frame" x="0.0" y="0.0" width="200" height="170"/>
                    </imageView>
                    <!-- ✅ اسم الفريق تحت الصورة بمسافة 10 -->
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Team Name" textAlignment="center" lineBreakMode="middleTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="YES" minimumFontScaleFactor="0.5" translatesAutoresizingMaskIntoConstraints="NO" id="label-id">
                        <rect key="frame" x="8" y="180" width="184" height="32"/>
                        <fontDescription key="fontDescription" type="boldSystem" pointSize="14"/>
                        <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <nil key="highlightedColor"/>
                    </label>
                </subviews>
                <!-- ✅ background شفاف -->
                <color key="backgroundColor" red="0" green="0" blue="0" alpha="0" colorSpace="custom" customColorSpace="sRGB"/>
                <constraints>
                    <!-- ImageView: top, leading, trailing = 0، height = 75% -->
                    <constraint firstItem="img-view-id" firstAttribute="top" secondItem="K03-LL-kra" secondAttribute="top" id="img-top"/>
                    <constraint firstItem="img-view-id" firstAttribute="leading" secondItem="K03-LL-kra" secondAttribute="leading" id="img-leading"/>
                    <constraint firstAttribute="trailing" secondItem="img-view-id" secondAttribute="trailing" id="img-trailing"/>
                    <constraint firstItem="img-view-id" firstAttribute="height" secondItem="K03-LL-kra" secondAttribute="height" multiplier="0.75" id="img-height"/>

                    <!-- Label: تحت الصورة بمسافة 10 -->
                    <constraint firstItem="label-id" firstAttribute="top" secondItem="img-view-id" secondAttribute="bottom" constant="10" id="label-top"/>
                    <constraint firstItem="label-id" firstAttribute="leading" secondItem="K03-LL-kra" secondAttribute="leading" constant="8" id="label-leading"/>
                    <constraint firstAttribute="trailing" secondItem="label-id" secondAttribute="trailing" constant="8" id="label-trailing"/>
                    <constraint firstAttribute="bottom" secondItem="label-id" secondAttribute="bottom" constant="8" id="label-bottom"/>
                </constraints>
            </collectionViewCellContentView>
            <connections>
                <outlet property="teamImg" destination="img-view-id" id="xXc-Rf-vxX"/>
                <outlet property="teamName" destination="label-id" id="yRv-9Y-L0u"/>
            </connections>
            <point key="canvasLocation" x="138.93129770992365" y="139.43661971830986"/>
        </collectionViewCell>
    </objects>
</document>
